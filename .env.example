# Copy this file to .env and fill in the values. .env is ignored by git.

# Postgres from compose.yaml
DATABASE_URL=postgresql+psycopg://briefing:briefing@127.0.0.1:5432/briefing

# Anthropic API key for scoring. Paste your own key; never commit it.
ANTHROPIC_API_KEY=

# Models: Haiku scores every article; Sonnet writes up the few that make the briefing.
# Leave WRITEUP_MODEL empty to send the scorer's one-line reasons instead.
SCORE_MODEL=claude-haiku-5-5
WRITEUP_MODEL=claude-sonnet-5-5

# Mailpit from compose.yaml catches all mail locally (view it at http://localhost:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USE_SSL=false
MAIL_FROM=Briefing Engine <briefing@briefing.test>

# Stage 2: signs the API's pagination cursors. Any long random string.
CURSOR_HMAC_KEY=

# Stage 2 on AWS (infra/): a Cloudflare API token with "Zone: Zone: Read" and
# "Zone: DNS: Edit", both on your domain only. Terraform looks the zone up by name, then
# adds the SES, certificate and API records.
CLOUDFLARE_API_TOKEN=
